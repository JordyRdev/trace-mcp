{
  "name": "trace-memory-mcp",
  "version": "0.1.3",
  "description": "A memory layer for AI tools. One SQLite file, evidence receipts, a review queue, exportable.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JordyRdev/trace-mcp.git"
  },
  "homepage": "https://github.com/JordyRdev/trace-mcp#readme",
  "bugs": {
    "url": "https://github.com/JordyRdev/trace-mcp/issues"
  },
  "keywords": [
    "mcp",
    "memory",
    "sqlite",
    "local-first",
    "model-context-protocol"
  ],
  "type": "module",
  "bin": {
    "trace": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}
